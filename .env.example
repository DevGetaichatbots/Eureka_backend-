# ==============================================================================
# WhatsApp Bot & Conversation Viewer - Environment Variables Template
# All variables defined here match the Technical Build Specification (Section 5).
# Copy this file to .env and fill in real credentials before starting the service.
# ==============================================================================

# Meta WhatsApp Cloud API (Developer Facebook Dashboard)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_random_verification_token_string
META_ACCESS_TOKEN=your_permanent_system_user_access_token
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WABA_ID=your_whatsapp_business_account_id
META_API_VERSION=v21.0

# Database & Supabase (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# n8n AI Bot Integration
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/whatsapp-inbound
N8N_CALLBACK_SECRET=your_shared_n8n_callback_secret_token

# Web Application & Viewer Session
SESSION_SECRET=your_32_character_random_session_secret_key
APP_BASE_URL=https://your-tunnel-or-render-app.com
FALLBACK_MESSAGE=Sorry, I'm having trouble answering right now. Please try again in a moment.

# Logging & Timezone
LOG_LEVEL=INFO
TZ=Asia/Karachi
CONVERSATION_WINDOW_HOURS=24
